<UserControl x:Class="VendingService.WPF.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="4,0,0,12"/>

        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="16">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Текущая сессия"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Foreground="#666" Text="Access token истекает:"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AccessTokenExpiresAtText}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Foreground="#666" Text="Refresh token истекает:"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding RefreshTokenExpiresAtText}"/>
                </Grid>

                <Border Margin="0,16,0,0" Background="#F7F7F7" CornerRadius="6" Padding="12">
                    <TextBlock Foreground="#666" TextWrapping="Wrap"
                               Text="Список всех сессий и управление ими добавим следующим шагом (понадобится хранить refresh-токены в БД)."/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>


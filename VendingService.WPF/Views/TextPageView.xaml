<UserControl x:Class="VendingService.WPF.Views.TextPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="4,0,0,12"/>
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="12">
            <TextBlock Foreground="#666" Text="{Binding Message}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>


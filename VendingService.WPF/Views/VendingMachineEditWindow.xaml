<Window x:Class="VendingService.WPF.Views.VendingMachineEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="760" Width="980"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_OnLoaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#FFFBE6" BorderBrush="#FFE58F" BorderThickness="1" Padding="10" CornerRadius="4"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="Название ТА *"/>
                        <TextBox Height="30" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,12">
                        <TextBlock Text="Производитель ТА *"/>
                        <ComboBox Height="30"
                                  ItemsSource="{Binding Manufacturers}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding ManufacturerId}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Модель ТА *"/>
                        <ComboBox Height="30"
                                  ItemsSource="{Binding FilteredModels}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding ModelId}"/>
                    </StackPanel>

                    <!-- Row 1 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="Режим работы *"/>
                        <ComboBox Height="30"
                                  ItemsSource="{Binding WorkModes}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding WorkModeId}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,12">
                        <TextBlock Text="Часовой пояс *"/>
                        <ComboBox Height="30"
                                  ItemsSource="{Binding TimeZones}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding TimeZoneId}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Статус *"/>
                        <ComboBox Height="30"
                                  ItemsSource="{Binding Statuses}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding StatusId}"/>
                    </StackPanel>

                    <!-- Row 2 -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="Адрес *"/>
                        <TextBox Height="30" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,12,12">
                        <TextBlock Text="Место *"/>
                        <TextBox Height="30" Text="{Binding Place, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Координаты (lat / lon)"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="120" Height="30" Text="{Binding LatitudeText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock VerticalAlignment="Center" Margin="8,0,8,0" Text="/"/>
                            <TextBox Width="120" Height="30" Text="{Binding LongitudeText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Row 3 -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="Инвентарный номер *"/>
                        <TextBox Height="30" Text="{Binding InventoryNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,12,12">
                        <TextBlock Text="Серийный номер *"/>
                        <TextBox Height="30" Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Страна *"/>
                        <ComboBox Height="30"
                                  ItemsSource="{Binding Countries}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding CountryId}"/>
                    </StackPanel>

                    <!-- Row 4 -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="Дата изготовления *"/>
                        <DatePicker SelectedDate="{Binding ManufactureDate}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,12,12">
                        <TextBlock Text="Дата ввода в эксплуатацию *"/>
                        <DatePicker SelectedDate="{Binding CommissioningDate}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Приоритет обслуживания *"/>
                        <ComboBox Height="30"
                                  ItemsSource="{Binding ServicePriorities}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding ServicePriorityId}"/>
                    </StackPanel>

                    <!-- Row 5 -->
                    <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="Компания (франчайзи)"/>
                        <ComboBox Height="30"
                                  ItemsSource="{Binding Companies}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding CompanyId}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,12,12">
                        <TextBlock Text="Модем"/>
                        <ComboBox Height="30"
                                  ItemsSource="{Binding Modems}"
                                  DisplayMemberPath="ModemNumber"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding ModemId}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Товарная матрица *"/>
                        <ComboBox Height="30"
                                  ItemsSource="{Binding ProductMatrices}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding ProductMatrixId}"/>
                    </StackPanel>

                    <!-- Row 6 -->
                    <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="Шаблон крит. значений"/>
                        <ComboBox Height="30"
                                  ItemsSource="{Binding CriticalValuesTemplates}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding CriticalValuesTemplateId}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,0,12,12">
                        <TextBlock Text="Шаблон уведомлений"/>
                        <ComboBox Height="30"
                                  ItemsSource="{Binding NotificationTemplates}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding NotificationTemplateId}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="6" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Платежные системы *"/>
                        <ItemsControl ItemsSource="{Binding PaymentSystems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="0,4,12,0" Content="{Binding Name}" IsChecked="{Binding IsSelected}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Row 7 -->
                    <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                        <TextBlock Text="Примечания"/>
                        <TextBox Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="110" Height="34" Margin="0,0,8,0" Content="Отменить" Click="CancelButton_OnClick"/>
            <Button Width="110" Height="34" Content="Сохранить" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>

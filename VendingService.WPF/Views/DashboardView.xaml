<UserControl x:Class="VendingService.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:vm="clr-namespace:VendingService.WPF.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,4,10">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,0" Foreground="#666" Text="{Binding UpdatedAtText}"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Width="110" Height="32" Content="Обновить" Command="{Binding RefreshCommand}"/>
                <Button Margin="10,0,0,0" Height="32" Content="Показать все плитки" Command="{Binding ShowAllTilesCommand}"/>
            </StackPanel>

            <Expander Margin="0,8,0,0" Header="Плитки">
                <ItemsControl ItemsSource="{Binding Tiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="0,0,18,6"
                                      Content="{Binding Title}"
                                      IsChecked="{Binding IsVisible}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>

        <ListBox Grid.Row="1"
                 x:Name="TilesListBox"
                 ItemsSource="{Binding Tiles}"
                 BorderThickness="0"
                 Background="Transparent"
                 AllowDrop="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 PreviewMouseLeftButtonDown="TilesListBox_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="TilesListBox_PreviewMouseMove"
                 DragOver="TilesListBox_DragOver"
                 Drop="TilesListBox_Drop">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.Resources>
                    <Style x:Key="TileCardStyle" TargetType="Border">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="CornerRadius" Value="6"/>
                        <Setter Property="Padding" Value="12"/>
                    </Style>

                    <Style x:Key="TileHeaderTextStyle" TargetType="TextBlock">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="14"/>
                    </Style>

                    <Style x:Key="TileCloseButtonStyle" TargetType="Button">
                        <Setter Property="Content" Value="×"/>
                        <Setter Property="Width" Value="26"/>
                        <Setter Property="Height" Value="26"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="#666"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>

                    <DataTemplate DataType="{x:Type vm:NetworkEfficiencyTileViewModel}">
                        <Border Style="{StaticResource TileCardStyle}"
                                Width="{Binding TileWidth}" Height="{Binding TileHeight}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TileHeaderTextStyle}" Text="{Binding Title}"/>
                                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource TileCloseButtonStyle}" Command="{Binding HideCommand}"/>

                                <oxy:PlotView Grid.Row="1" Grid.ColumnSpan="2"
                                             Model="{Binding PlotModel}"
                                             Height="120"/>

                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                           HorizontalAlignment="Center"
                                           Foreground="#555"
                                           Text="{Binding Caption}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type vm:NetworkStateTileViewModel}">
                        <Border Style="{StaticResource TileCardStyle}"
                                Width="{Binding TileWidth}" Height="{Binding TileHeight}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TileHeaderTextStyle}" Text="{Binding Title}"/>
                                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource TileCloseButtonStyle}" Command="{Binding HideCommand}"/>

                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Height="140">
                                    <oxy:PlotView Model="{Binding PlotModel}"/>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="#333"
                                               TextAlignment="Center"
                                               Text="{Binding CenterText}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type vm:SummaryTileViewModel}">
                        <Border Style="{StaticResource TileCardStyle}"
                                Width="{Binding TileWidth}" Height="{Binding TileHeight}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TileHeaderTextStyle}" Text="{Binding Title}"/>
                                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource TileCloseButtonStyle}" Command="{Binding HideCommand}"/>

                                <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                              ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Foreground="#555" Text="{Binding Name}"/>
                                                <TextBlock Grid.Column="1" Foreground="#222" FontWeight="SemiBold" Text="{Binding Value}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type vm:SalesDynamicsTileViewModel}">
                        <Border Style="{StaticResource TileCardStyle}"
                                Width="{Binding TileWidth}" Height="{Binding TileHeight}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TileHeaderTextStyle}" Text="{Binding Title}"/>
                                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource TileCloseButtonStyle}" Command="{Binding HideCommand}"/>

                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Foreground="#666" Text="{Binding RangeText}"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Padding="10,4" Command="{Binding ShowAmountCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#E5E7EB"/>
                                                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Foreground" Value="#111"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAmountMode}" Value="True">
                                                            <Setter Property="Background" Value="#2D9CDB"/>
                                                            <Setter Property="BorderBrush" Value="#2D9CDB"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            По сумме
                                        </Button>
                                        <Button Margin="6,0,0,0" Padding="10,4" Command="{Binding ShowQuantityCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#E5E7EB"/>
                                                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Foreground" Value="#111"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsQuantityMode}" Value="True">
                                                            <Setter Property="Background" Value="#2D9CDB"/>
                                                            <Setter Property="BorderBrush" Value="#2D9CDB"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            По количеству
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <oxy:PlotView Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                             Model="{Binding PlotModel}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type vm:NewsTileViewModel}">
                        <Border Style="{StaticResource TileCardStyle}"
                                Width="{Binding TileWidth}" Height="{Binding TileHeight}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TileHeaderTextStyle}" Text="{Binding Title}"/>
                                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource TileCloseButtonStyle}" Command="{Binding HideCommand}"/>

                                <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Foreground="#666" Text="{Binding DateText}"/>
                                                    <TextBlock Grid.Column="1" Foreground="#111" TextWrapping="Wrap" Text="{Binding Title}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.Resources>
        </ListBox>
    </Grid>
</UserControl>

<Window x:Class="VendingService.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VendingService.WPF.ViewModels"
        mc:Ignorable="d"
        Title="VendingService — Вход" Height="340" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Вход в личный кабинет" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,16" Foreground="#666" Text="Введите email и пароль для входа."/>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Email"/>
            <TextBox Grid.Row="0" Grid.Column="1" Height="32"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Center" Text="Пароль"/>
            <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Height="32"
                         PasswordChanged="PasswordBox_OnPasswordChanged"/>
        </Grid>

        <Border Grid.Row="3" Background="#FFFBE6" BorderBrush="#FFE58F" BorderThickness="1" Padding="10" CornerRadius="4"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Width="120" Height="34" IsDefault="True"
                    Command="{Binding LoginCommand}"
                    Content="Войти"/>
        </StackPanel>
    </Grid>
</Window>

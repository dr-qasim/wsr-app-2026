<UserControl x:Class="VendingService.WPF.Views.VendingMachinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="Торговые автоматы" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Foreground="#666"
                       Text="{Binding TotalCount, StringFormat=Всего найдено: {0}}"/>
        </DockPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" Text="Показать"/>
                <ComboBox Grid.Column="1" Width="80"
                          ItemsSource="{Binding PageSizes}"
                          SelectedItem="{Binding PageSize}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBox Width="240" Height="30" Margin="16,0,8,0"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Width="100" Height="30" Content="Найти" Command="{Binding SearchCommand}"/>
                </StackPanel>

                <Button Grid.Column="3" Width="120" Height="30" Margin="12,0,8,0"
                        Content="Добавить" Click="AddButton_OnClick"/>

                <Button Grid.Column="4" Width="120" Height="30" Content="Экспорт" Click="ExportButton_OnClick">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="CSV" Click="ExportCsv_OnClick"/>
                            <MenuItem Header="HTML" Click="ExportHtml_OnClick"/>
                            <MenuItem Header="PDF" Click="ExportPdf_OnClick"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="12">
            <DataGrid ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      AlternationCount="2"
                      AlternatingRowBackground="#F7F7F7"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding VendingMachineId}" Width="80"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                    <DataGridTemplateColumn Header="Модель" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Inlines>
                                        <Run Text="{Binding ManufacturerName}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding ModelName}"/>
                                    </TextBlock.Inlines>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Компания" Width="220" Binding="{Binding CompanyName}"/>
                    <DataGridTemplateColumn Header="Модем" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding ModemNumber}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ModemId}" Value="-1">
                                                    <Setter Property="Text" Value="-1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Адрес/Место" Width="260">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Inlines>
                                        <Run Text="{Binding Address}"/>
                                        <Run Text=", "/>
                                        <Run Text="{Binding Place}"/>
                                    </TextBlock.Inlines>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="В работе с" Width="120" Binding="{Binding CommissioningDate}"/>
                    <DataGridTemplateColumn Header="Действия" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Width="32" Height="26" Margin="0,0,6,0" Content="✏" Click="EditButton_OnClick"/>
                                    <Button Width="32" Height="26" Margin="0,0,6,0" Content="⛓" Click="DetachButton_OnClick"/>
                                    <Button Width="32" Height="26" Content="🗑" Click="DeleteButton_OnClick"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#666"
                       Text="{Binding PageInfo}"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Width="90" Margin="0,0,8,0" Content="Назад" Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanGoPrev}"/>
                <Button Width="90" Content="Вперед" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>

<UserControl x:Class="VendingService.WPF.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Foreground="#666"
                       Text="{Binding TotalCount, StringFormat=Всего записей: {0}}"/>
        </DockPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" Text="Показать"/>
                <ComboBox Grid.Column="1" Width="80"
                          ItemsSource="{Binding PageSizes}"
                          SelectedItem="{Binding PageSize}"/>

                <Button Grid.Column="2" Width="110" Height="30" HorizontalAlignment="Left"
                        Content="Обновить" Command="{Binding LoadCommand}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="12">
            <DataGrid ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      AlternationCount="2"
                      AlternatingRowBackground="#F7F7F7"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding SaleId}" Width="80"/>
                    <DataGridTextColumn Header="Торговый автомат" Binding="{Binding VendingMachineName}" Width="220"/>
                    <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="200"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="90"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="120"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding SoldAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"/>
                    <DataGridTextColumn Header="Оплата" Binding="{Binding SalePaymentMethodName}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#666"
                       Text="{Binding PageInfo}"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Width="90" Margin="0,0,8,0" Content="Назад" Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanGoPrev}"/>
                <Button Width="90" Content="Вперед" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>

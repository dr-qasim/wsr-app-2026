<Window x:Class="VendingService.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VendingService.WPF.ViewModels"
        xmlns:views="clr-namespace:VendingService.WPF.Views"
        mc:Ignorable="d"
        Title="VendingService" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:ShellViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VendingMachinesViewModel}">
            <views:VendingMachinesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompaniesViewModel}">
            <views:CompaniesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
            <views:MonitorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}">
            <views:UsersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModemsViewModel}">
            <views:ModemsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
            <views:ProfileView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TextPageViewModel}">
            <views:TextPageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToastViewModel}">
            <Border CornerRadius="8" Padding="12" Width="360">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#2D9CDB"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Critical">
                                <Setter Property="Background" Value="#D32F2F"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                <Setter Property="Background" Value="#F57C00"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Info">
                                <Setter Property="Background" Value="#2E7D32"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Foreground="White" FontWeight="SemiBold"
                               Text="{Binding Title}"/>
                    <Button Grid.Row="0" Grid.Column="1" Width="26" Height="26"
                            Content="X"
                            Command="{Binding CloseCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            Padding="0"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0"
                               Foreground="White"
                               TextWrapping="Wrap"
                               MaxHeight="44"
                               Text="{Binding Message}"/>

                    <Button Grid.Row="2" Grid.Column="0" Margin="0,10,0,0"
                            Width="90" Height="28"
                            Content="Понятно"
                            Command="{Binding AcknowledgeCommand}"
                            Visibility="{Binding RequiresAcknowledgement, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2B3640"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#33404B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToGridLengthConverter}}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#1F262D">
            <DockPanel>
                <Button DockPanel.Dock="Top" Height="44"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding ToggleSidebarCommand}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE700;"/>
                </Button>

                <StackPanel DockPanel.Dock="Top">
                    <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateDashboardCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="22" FontFamily="Segoe MDL2 Assets" Text="&#xE80F;"/>
                            <TextBlock Text="Главная" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateMonitorCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="22" FontFamily="Segoe MDL2 Assets" Text="&#xE8A7;"/>
                            <TextBlock Text="Монитор ТА" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateReportsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="22" FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;"/>
                            <TextBlock Text="Детальные отчеты" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateInventoryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="22" FontFamily="Segoe MDL2 Assets" Text="&#xE7C3;"/>
                            <TextBlock Text="Учет ТМЦ" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>

                    <Expander Margin="0,4,0,0" Background="Transparent" BorderThickness="0" IsExpanded="True">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Margin="12,10">
                                <TextBlock Width="22" Foreground="#E6E6E6" FontFamily="Segoe MDL2 Assets" Text="&#xE713;"/>
                                <TextBlock Foreground="#E6E6E6" Text="Администрирование"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel>
                            <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateVendingMachinesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="22" Text="•"/>
                                    <TextBlock Text="Торговые автоматы" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateCompaniesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="22" Text="•"/>
                                    <TextBlock Text="Компании" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateUsersCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="22" Text="•"/>
                                    <TextBlock Text="Пользователи" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateModemsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="22" Text="•"/>
                                    <TextBlock Text="Модемы" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateAdditionalCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="22" Text="•"/>
                                    <TextBlock Text="Дополнительные" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1" Background="#F2F2F2">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="#222" Padding="12,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Left" Foreground="#FFF" FontSize="16" FontWeight="SemiBold"
                               Text="ООО Торговые Автоматы"/>
                    <Menu DockPanel.Dock="Right"
                          Background="Transparent"
                          Foreground="#FFF"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right">
                        <MenuItem Background="Transparent">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="14" Background="#3A3A3A" Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="#FFF" FontWeight="SemiBold"
                                                   Text="{Binding UserInitials}"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Foreground="#FFF" Text="{Binding UserDisplayName}"/>
                                        <TextBlock Foreground="#AAA" FontSize="12" Text="{Binding RoleName}"/>
                                    </StackPanel>
                                </StackPanel>
                            </MenuItem.Header>

                            <MenuItem Header="Мой профиль" Command="{Binding NavigateProfileCommand}"/>
                            <Separator/>
                            <MenuItem Header="Выход" Command="{Binding LogoutCommand}"/>
                        </MenuItem>
                    </Menu>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="12"/>

            <!-- Toast notifications -->
            <Border Grid.RowSpan="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,16"
                    Panel.ZIndex="999"
                    Visibility="{Binding ToastService.HasToast, Converter={StaticResource BoolToVisibilityConverter}}">
                <ContentControl Content="{Binding ToastService.CurrentToast}"/>
            </Border>
        </Grid>
    </Grid>
</Window>

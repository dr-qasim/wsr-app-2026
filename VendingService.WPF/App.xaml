<Application x:Class="VendingService.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VendingService.WPF.Converters"
             xmlns:local="clr-namespace:VendingService.WPF"
             StartupUri="Views/LoginWindow.xaml">
    <Application.Resources>
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter"/>
        <conv:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter" TrueLength="60" FalseLength="220"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:BoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" Invert="True"/>
        <conv:EquipmentOkTotalToBrushConverter x:Key="EquipmentOkTotalToBrushConverter"/>
    </Application.Resources>
</Application>

<UserControl x:Class="VendingService.WPF.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_OnLoaded"
             Unloaded="UserControl_OnUnloaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="Монитор торговых автоматов" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Foreground="#666"
                       Text="{Binding GeneratedAtText}"/>
        </DockPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="100" Height="30" Margin="0,0,8,0" Content="Применить" Command="{Binding ApplyFiltersCommand}"/>
                    <Button Width="100" Height="30" Margin="0,0,8,0" Content="Очистить" Command="{Binding ClearFiltersCommand}"/>
                    <Button Width="100" Height="30" Content="Обновить" Command="{Binding RefreshCommand}"/>
                </StackPanel>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Общее состояние:"/>

                        <ToggleButton Width="34" Height="28" Margin="10,0,0,0"
                                      Command="{Binding ToggleOverallStatusCommand}"
                                      CommandParameter="{Binding WorkStatusId}"
                                      IsChecked="{Binding IsWorkSelected, Mode=OneWay}">
                            <Ellipse Width="14" Height="14" Fill="#2E7D32"/>
                        </ToggleButton>
                        <ToggleButton Width="34" Height="28" Margin="6,0,0,0"
                                      Command="{Binding ToggleOverallStatusCommand}"
                                      CommandParameter="{Binding DownStatusId}"
                                      IsChecked="{Binding IsDownSelected, Mode=OneWay}">
                            <Ellipse Width="14" Height="14" Fill="#D32F2F"/>
                        </ToggleButton>
                        <ToggleButton Width="34" Height="28" Margin="6,0,0,0"
                                      Command="{Binding ToggleOverallStatusCommand}"
                                      CommandParameter="{Binding ServiceStatusId}"
                                      IsChecked="{Binding IsServiceSelected, Mode=OneWay}">
                            <Ellipse Width="14" Height="14" Fill="#1976D2"/>
                        </ToggleButton>

                        <TextBlock VerticalAlignment="Center" Margin="20,0,8,0" FontWeight="SemiBold" Text="Подключение:"/>
                        <ItemsControl ItemsSource="{Binding ConnectionTypes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Margin="4,0,0,0" Padding="8,4"
                                                  Content="{Binding Name}"
                                                  IsChecked="{Binding IsSelected}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Доп. статусы:"/>
                        <ItemsControl ItemsSource="{Binding AdditionalStatuses}" Margin="8,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Margin="4,0,0,0" Padding="8,4"
                                                  Content="{Binding Name}"
                                                  IsChecked="{Binding IsSelected}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="12">
            <Grid>
                <DataGrid ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          AlternationCount="2"
                          AlternatingRowBackground="#F7F7F7"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          LoadingRow="DataGrid_OnLoadingRow">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="№" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center"
                                               Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="ТП" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold">
                                            <TextBlock.Inlines>
                                                <Run Text="{Binding VendingMachineId}"/>
                                                <Run Text=" - "/>
                                                <Run Text="{Binding Name}"/>
                                            </TextBlock.Inlines>
                                        </TextBlock>
                                        <TextBlock Foreground="#666">
                                            <TextBlock.Inlines>
                                                <Run Text="{Binding ManufacturerName}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding ModelName}"/>
                                            </TextBlock.Inlines>
                                        </TextBlock>
                                        <TextBlock Foreground="#666">
                                            <TextBlock.Inlines>
                                                <Run Text="{Binding Address}"/>
                                                <Run Text=", "/>
                                                <Run Text="{Binding Place}"/>
                                            </TextBlock.Inlines>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Связь" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock>
                                            <Run Text="{Binding IsOnline, StringFormat=Онлайн: {0}}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="#666" Text="{Binding ConnectionTypeName}"/>
                                        <TextBlock Foreground="#666" Text="{Binding ProviderName}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Загрузка" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <ProgressBar Height="14" Minimum="0" Maximum="100" Value="{Binding LoadOverallPercent}"/>
                                        <TextBlock Margin="0,6,0,0" Foreground="#666"
                                                   Text="{Binding LoadOverallPercent, StringFormat=Общая: {0}%}"/>
                                        <TextBlock Foreground="#666"
                                                   Text="{Binding LoadMinPercent, StringFormat=Мин.: {0}%}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Денежные средства" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding MoneyOnAccount, StringFormat=Счет: {0:N0} р.}"/>
                                        <TextBlock Foreground="#666"
                                                   Text="{Binding CashCoins, StringFormat=Монеты: {0:N0} р.}"/>
                                        <TextBlock Foreground="#666"
                                                   Text="{Binding CashBills, StringFormat=Купюры: {0:N0} р.}"/>
                                        <TextBlock Foreground="#666"
                                                   Text="{Binding CashChange, StringFormat=Сдача: {0:N0} р.}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="События" Width="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding RecentEvents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Foreground="#444">
                                                    <TextBlock.Inlines>
                                                        <Run Text="{Binding OccurredAt, StringFormat={}{0:HH:mm}}"/>
                                                        <Run Text=" - "/>
                                                        <Run Text="{Binding EventTypeName}"/>
                                                    </TextBlock.Inlines>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Оборудование" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold">
                                        <TextBlock.Foreground>
                                            <MultiBinding Converter="{StaticResource EquipmentOkTotalToBrushConverter}">
                                                <Binding Path="EquipmentOkCount"/>
                                                <Binding Path="EquipmentTotalCount"/>
                                            </MultiBinding>
                                        </TextBlock.Foreground>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}/{1}">
                                                <Binding Path="EquipmentOkCount"/>
                                                <Binding Path="EquipmentTotalCount"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Информация" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding AdditionalStatusCodes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,6,6" Background="#EEE" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Foreground="#444" Text="{Binding}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Доп." Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center" Foreground="#666" Text="—"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" Foreground="#666"
                           Text="Нет активных торговых автоматов, соответствующих заданному фильтру"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#666"
                       Text="{Binding TotalsText}"/>
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#666"
                       Text="{Binding MoneyTotalsText}"/>
        </DockPanel>
    </Grid>
</UserControl>
